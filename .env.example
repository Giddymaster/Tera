# ============================================================
#  Example environment file.
#  Copy to .env and fill in real values. NEVER commit .env.
#    cp .env.example .env          (macOS/Linux)
#    Copy-Item .env.example .env   (Windows PowerShell)
# ============================================================

# ---- Core app ----
APP_ENV=development                 # development | production
APP_NAME=Employee Device Manager
LOG_LEVEL=info                      # debug | info | warning | error

# ---- Backend server ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API (the frontend dev URL).
CORS_ALLOW_ORIGINS=http://localhost:5173

# ---- Database ----
# Local development can use SQLite (no server needed):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Production uses PostgreSQL, for example:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ---- Security / auth ----
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# There is intentionally NO default here. The app must refuse to start
# in production without a real secret set.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15             # short-lived access tokens
REFRESH_TOKEN_DAYS=7

# ---- Screenshots (encryption at rest) ----
# Fernet key (urlsafe base64, 32 bytes). Generate one with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Required in production; a temporary key is generated in development.
SCREENSHOT_KEY=
# Where encrypted screenshot blobs are stored (gitignored).
SCREENSHOT_DIR=./screenshots

# ---- Frontend (Vite reads VITE_* at build time) ----
VITE_API_BASE_URL=http://localhost:8000
