# Copy to .env.production and fill in real values. NEVER commit .env.production.

# Public domain for TLS + CORS. Use your real domain (DNS A record -> this host).
# For a local test you may use "localhost" (Caddy uses a self-signed cert).
DOMAIN=devices.example.com

APP_ENV=production

# Secrets — generate strong values:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SCREENSHOT_KEY=

# PostgreSQL (kept private; not exposed outside the Docker network)
POSTGRES_USER=edm
POSTGRES_PASSWORD=
POSTGRES_DB=edm

# Persistent storage inside the backend container (the appdata volume)
SCREENSHOT_DIR=/data/screenshots
BACKUP_DIR=/data/backups

# Browser origin allowed to call the API (same domain over HTTPS)
CORS_ALLOW_ORIGINS=https://devices.example.com

# Latest agent version admins should be on (shown as "update available")
AGENT_LATEST_VERSION=0.6.0

# API worker processes. Keep at 1 unless you add a shared rate-limit store.
WEB_CONCURRENCY=1
